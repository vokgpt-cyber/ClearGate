# =============================================================================
# CLEARGATE .gitignore
# =============================================================================

# ----------- Secrets and Environment -----------
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
secrets/
.secrets/
*.crt
*.pfx
api_keys.json

# ----------- Sensitive client data (NEVER commit) -----------
# Real client documents — synthetic only allowed in tests/fixtures
client_data/
real_documents/
*.real.docx
*.real.pdf
mapping_tables/
*.mapping
*.session
backend/data/
*.db

# ----------- Python -----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.venv.*/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# The Python `lib/` rule above would otherwise swallow the frontend's
# source library folder (frontend/src/lib/**), which contains api.ts,
# entity-overlay.ts, docx-anchor-map.ts, debug-log.ts, etc. Without
# these negations ALL of those files silently drop out of git tracking
# and every snapshot is missing them. Do not remove.
!frontend/src/lib/
!frontend/src/lib/**

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.cache/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints
*.ipynb

# ----------- Node / TypeScript / Next.js -----------
node_modules/
.npm
.yarn/
.pnp.*
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts

# Next.js
.next/
out/
.vercel/

# ----------- Tauri / Rust -----------
target/
**/*.rs.bk
*.pdb
src-tauri/target/
src-tauri/Cargo.lock

# ----------- ML Models (NEVER commit — too large) -----------
models/
!backend/app/models/
!backend/app/models/**
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.h5
ollama_data/
.ollama/

# spaCy models
**/ru_core_news_*/
**/en_core_web_*/

# ----------- IDE / Editors -----------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----------- OS -----------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----------- Docker -----------
.docker/
docker-compose.override.yml

# ----------- Logs -----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------- Backups (handled separately) -----------
backups/
*.bundle
*.backup
*.bak

# ----------- Build artifacts -----------
*.tar.gz
*.zip
*.7z

# ----------- Claude Code local state -----------
.claude/cache/
.claude/local/
# Note: .claude/settings.json and .claude/commands/ ARE committed

# ----------- Temporary files -----------
tmp/
temp/
.tmp/
*.tmp
