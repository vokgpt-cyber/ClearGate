# =============================================================================
# CLEARGATE Environment Variables — TEMPLATE
# =============================================================================
# Скопируй этот файл в .env и заполни значения.
# .env НИКОГДА не коммитится в git (см. .gitignore).
# =============================================================================

# ----------- Profile (alpha | mvp | final) -----------
# Определяет, какие модели и параметры использовать
CLEARGATE_PROFILE=alpha

# ----------- LLM API Keys -----------
# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI GPT
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------- Default Models (per provider) -----------
DEFAULT_CLAUDE_MODEL=claude-opus-4-6
DEFAULT_OPENAI_MODEL=gpt-5.4
DEFAULT_GEMINI_MODEL=gemini-3.1-pro-preview

# Default thinking/reasoning level (low | medium | high | max)
DEFAULT_THINKING_LEVEL=high

# ----------- Local LLM (Ollama) -----------
# Внутри docker compose backend ходит к ollama по DNS-имени контейнера,
# поэтому правильное значение - http://ollama:11434, а не localhost.
# Для запуска backend вне docker (локальная разработка) - localhost.
OLLAMA_HOST=http://ollama:11434
# Модель локальной LLM зависит от профиля:
# alpha → qwen2.5:7b-instruct-q4_K_M
# mvp   → qwen2.5:32b-instruct-q4_K_M
# final → qwen2.5:72b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Полностью отключить LLM-уровень верификации (Layer 3).
# На CPU-only сервере один запрос к Qwen занимает 30-60 секунд - если для
# вашего пилота это слишком медленно, выставьте true: останутся только
# regex (Layer 1) и spaCy NER (Layer 2). Качество анонимизации немного
# упадёт, но интерактивность вернётся.
CLEARGATE_DISABLE_LLM_LAYER=false

# ----------- spaCy Model -----------
SPACY_MODEL=ru_core_news_lg

# ----------- GLiNER Model -----------
# alpha → urchade/gliner_medium-v2.1
# mvp/final → urchade/gliner_large-v2.1
GLINER_MODEL=urchade/gliner_medium-v2.1

# ----------- Backend Settings -----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_LOG_LEVEL=info
# CORS origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,tauri://localhost

# ----------- Frontend Settings -----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_DEFAULT_THEME=dark

# ----------- Crypto / Security -----------
# Master key для шифрования mapping table (AES-256-GCM)
# В production генерируется безопасным способом, в dev можно случайной строкой
# Сгенери