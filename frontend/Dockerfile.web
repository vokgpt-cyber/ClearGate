FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci
# Bundle `serve` into the image so the container doesn't do a lazy install
# on first start (which slows pilot bring-up and can fail if the VM has
# restricted outbound network access).
RUN npm install -g serve@14

COPY . .

# Build-time configuration.
# Next.js with `output: 'export'` inlines NEXT_PUBLIC_* values into the
# static JS at build time — the same env vars set at runtime do NOTHING.
# Empty values mean same-origin `/api` and `/ws` behind nginx.
# Local compose/dev profiles pass explicit localhost args.
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_WS_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL

RUN npm run build

EXPOSE 3000

# Serve the static export. `-s` enables SPA fallback so deep links resolve.
CMD ["serve", "out", "-l", "3000", "-s"]
