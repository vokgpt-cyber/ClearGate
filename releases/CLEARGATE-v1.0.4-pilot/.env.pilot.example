# CLEARGATE v1.0.4 pilot server configuration
# Copy this file to repository root as `.env` before deployment, or let
# scripts/install-cleargate.sh create `.env` from this template.

# Public DNS name or internal hostname users will open in the browser.
# Examples: cleargate.company.local, cleargate-test.internal
CLEARGATE_DOMAIN=cleargate.local

# TLS mode:
# - selfsigned: installer generates a self-signed certificate. Fastest for lab.
# - corp_ca: IT places corporate certificate files into /opt/cleargate/certs.
# - letsencrypt: public DNS + inbound port 80 required.
CLEARGATE_TLS_MODE=selfsigned

# HuggingFace token is optional, but recommended to avoid download throttling
# during first model pull. Leave empty if IT policy does not allow it.
HF_TOKEN=

# Local GPU LLM verifier via vLLM.
# On a 48 GB GPU, Qwen3-32B-AWQ + BGE-M3 should fit with headroom.
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_UTIL=0.85
EMBEDDER_MODEL=BAAI/bge-m3

# Backend uses vLLM through OpenAI-compatible /v1 endpoint.
# Do not change unless IT intentionally replaces vLLM.
OLLAMA_HOST=http://vllm:8000/v1
OLLAMA_MODEL=cleargate-llm
EMBEDDER_URL=http://bge-embedder:80

# Keep LLM verifier available for the pilot. Users should treat "Deep scan" as
# an optional QA assistant, not as the main anonymization engine.
CLEARGATE_DISABLE_LLM_LAYER=false

# NER models. The Docker image currently downloads ru_core_news_sm during build.
# ru_core_news_lg can be used when baked into the image in a later hardening pass.
SPACY_MODEL=ru_core_news_sm
GLINER_MODEL=urchade/gliner_medium-v2.1

# Same-origin browser access through nginx.
BACKEND_CORS_ORIGINS=https://${CLEARGATE_DOMAIN}
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Auth session secret. Empty value means backend creates /app/data/session_cookie.key
# in the persistent data volume on first startup. IT may fill a generated hex value
# if deterministic secret management is required.
CLEARGATE_SESSION_COOKIE_SECRET=
CLEARGATE_AUTH_SESSION_TTL_MINUTES=720

# LDAP / Active Directory. Empty values mean local users only.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_ADMIN_GROUP_DN=
LDAP_USER_GROUP_DN=
LDAP_TIMEOUT_SECONDS=5
